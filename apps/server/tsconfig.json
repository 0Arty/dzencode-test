{
   "compilerOptions": {
      "module": "commonjs",
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2021",
      "sourceMap": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "paths": {
         "@mono/types": ["../../shared/index.ts"]
      }
   },
   "include": ["src/**/*"]
}
