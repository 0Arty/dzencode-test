{
   "name": "monorepo",
   "private": true,
   "workspaces": [
      "apps/*",
      "packages/*"
   ],
   "scripts": {
      "dev:shared": "npm run dev -w packages/shared",
      "dev:client": "npm run dev -w apps/client",
      "dev:server": "npm run start:dev -w apps/server",
      "dev": "concurrently -n shared,server,client -c yellow,green,cyan \"npm run dev:shared\" \"npm run dev:server\" \"npm run dev:client\"",
      "build:shared": "npm run build -w packages/shared",
      "build:client": " npm run build -w apps/client",
      "build:server": "npm run build -w apps/server",
      "build": "npm run build:shared && npm run build:client && npm run build:server"
   },
   "devDependencies": {
      "@types/node": "^26.4.1",
      "concurrently": "^9.0.0"
   }
}
