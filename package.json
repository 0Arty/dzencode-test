{
   "name": "monorepo",
   "private": true,
   "workspaces": [
      "apps/*"
   ],
   "scripts": {
      "dev:client": "npm run dev -w apps/client",
      "dev:server": "npm run start:dev -w apps/server",
      "dev": "concurrently -n server,client -c green,cyan  \"npm run dev:server\" \"npm run dev:client\"",
      "build:client": " npm run build -w apps/client",
      "build:server": "npm run build -w apps/server",
      "build": "npm run build:client && npm run build:server"
   },
   "devDependencies": {
      "@types/node": "^26.4.1",
      "concurrently": "^9.0.0"
   },
   "dependencies": {
      "@reduxjs/toolkit": "^2.12.0",
      "react-redux": "^9.3.0"
   }
}
